{
  "rules": {
    "apps": {
      "$appId": {
        "devices": {
          ".read": "auth != null && auth.uid === 'kafrokoRerMRQj4z4i606mFJJKg2'",
          ".indexOn": ["status", "lastSeenAt", "createdAt"],
          "$deviceCode": {
            ".read": "true",
            ".write": "auth != null && auth.uid === 'kafrokoRerMRQj4z4i606mFJJKg2' || !data.exists() && newData.child('status').val() == 'pending' || data.child('status').val() == 'pending' && newData.child('status').val() == 'pending' || data.child('status').val() == 'active' && newData.child('status').val() == 'active'",
            ".validate": "newData.hasChildren(['status', 'updatedAt']) && $deviceCode.matches(/^[2-9A-HJ-NP-Z]{12}$/) && newData.child('status').val().matches(/^(pending|active|revoked)$/) && (!newData.child('expiresAt').exists() || newData.child('expiresAt').val() == 0 || newData.child('expiresAt').val() > 1700000000000 && newData.child('expiresAt').val() < 5000000000000)",
            "status": {
              ".write": "auth != null && auth.uid === 'kafrokoRerMRQj4z4i606mFJJKg2' || (!data.exists() || data.val() == 'pending') && newData.val() == 'pending'"
            },
            "expiresAt": {
              ".write": "auth != null && auth.uid === 'kafrokoRerMRQj4z4i606mFJJKg2'"
            },
            "note": {
              ".write": "auth != null && auth.uid === 'kafrokoRerMRQj4z4i606mFJJKg2'",
              ".validate": "!newData.exists() || newData.val().length <= 300"
            },
            "school": {
              ".write": "true",
              ".validate": "!newData.exists() || newData.val().length <= 120"
            },
            "principal": {
              ".write": "true",
              ".validate": "!newData.exists() || newData.val().length <= 120"
            },
            "phone": {
              ".write": "true",
              ".validate": "!newData.exists() || newData.val().length <= 40"
            },
            "deviceType": {
              ".write": "true",
              ".validate": "!newData.exists() || newData.val().matches(/^(mobile|tablet|desktop|unknown)$/)"
            },
            "lastSeenAt": {
              ".write": "true",
              ".validate": "!newData.exists() || newData.val() > 0"
            },
            "origin": {
              ".write": "true",
              ".validate": "!newData.exists() || newData.val().length <= 100"
            },
            "ua": {
              ".write": "true",
              ".validate": "!newData.exists() || newData.val().length <= 200"
            }
          }
        }
      }
    }
  }
}
